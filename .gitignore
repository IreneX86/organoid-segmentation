# Biological images and annotations are local-only.
data/
label_ref/
organoid_data/
*.tif
*.tiff

# Models, predictions, experiment output, and transfer archives.
*.keras
*.h5
*.npz
*.npy
*.tar
*.tar.gz
*.zip
# Narrow exceptions for explicitly requested generated-mask deliveries.
!deliverables/mito_auto_labels/*/Mito_label.zip
# Explicitly requested LD mask delivery; keep the global ZIP/data ignore intact.
!deliverables/ld_auto_labels/*/fluo_label.zip
# Separate 1/5 vote masks; no exception for other ZIPs or source data.
!deliverables/ld_vote1_auto_labels/*/fluo_label_vote1.zip
artifacts/
outputs/
predictions/
runpod_results/
*.log

# Local work copies and Cetus-specific scripts with account paths.
phase12_work/
legacy/
*.pbs

# Python and OS generated files.
__pycache__/
*.py[cod]
.venv/
venv/
.DS_Store
._*
__MACOSX/
.pytest_cache/
.ruff_cache/

# Credentials and private configuration.
.env
.env.*
.ssh/
.aws/
credentials/
*credentials*
id_rsa*
id_ed25519*
*.pem
*.key
known_hosts*
.netrc
